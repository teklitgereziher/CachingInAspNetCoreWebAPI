{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PostgresSettings": {
    "Scope": [ "https://ossrdbms-aad.database.windows.net/.default" ],
    "ConnectionString": "User Id=techuser;Password=strpass@tech;Server=<your-server",
    "DevConnectionString": "User Id=techuser;Password=strpass@tech;Server=localhost;Port=5432;Database=BoardGamesDb;"
  },
  "Redis": {
    "Host": "localhost:6379"
  },
  "AzureAdSettings": {
    "TenantId": "11111111-2222-3333-4444-555555555555",
    "ClientId": "00000000-aaaa-bbbb-cccc-111111111111",
    "ClientSecret": "fake-client-secret-12345"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System.Net.Http.HttpClient": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.Extensions.Hosting": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [CorrelationId: {CorrelationId}] [ItemId: {GameId}] {SourceContext} {Message:lj} {Exception}{NewLine}"
          //"includeScope": true
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithClientIP",
      "WithClientAgent"
    ]
  },
  "AllowedHosts": "*"
}
